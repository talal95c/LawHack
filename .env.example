TYPESAFE_API_KEY=            # Jev (TypeSafe) ou clé Codiv
TYPESAFE_BASE_URL=           # vide = TypeSafe ; https://api.codiv.ai pour OpenJev
SYSTEM_ONE_MODEL=jev-latest  # ou openjev-latest
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
ANSWER_PROVIDER=mistral      # mistral | openrouter
ANSWER_MODEL=mistral-medium-latest
BASELINE_PROVIDER=openrouter
BASELINE_MODEL=openai/gpt-6-astra
ANSWER_TEMPERATURE=0
# Politique d'honnêteté (à calibrer sur le jeu labellisé)
CONFIDENCE_HIGH=0.8          # >= : réponse normale
CONFIDENCE_LOW=0.5           # entre LOW et HIGH : « à vérifier »
SUPPORT_MIN=0.5              # Jev : le segment cité soutient-il l'affirmation ?
ANSWERABLE_MIN=0.35          # Jev : l'arrêt répond-il ? sinon abstention sans appel Mistral
ROUTE_ABSTAIN=0.7            # confiance mini pour « hors arrêt »
RELEVANCE_MIN=0.3            # re-classement Jev des segments récupérés
RETRIEVAL_TOP_K=8
